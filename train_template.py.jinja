#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
YOLO模型训练脚本
自动生成于数据集划分时
"""

import os
import sys
import argparse

# 添加ultralytics到路径
try:
    from ultralytics import YOLO
except ImportError:
    print("请安装ultralytics: pip install ultralytics")
    sys.exit(1)


def find_best_model():
    """查找最佳模型文件"""
    best_model_path = 'runs/detect/train/weights/best.pt'
    
    if os.path.exists(best_model_path):
        return best_model_path
    return None


def train():
    """执行YOLO模型训练"""
    # 获取当前脚本所在目录
    current_dir = os.path.dirname(os.path.abspath(__file__))
    
    # 配置文件路径（train.yml位于同一目录下）
    data_yaml = os.path.join(current_dir, "train.yml")
    
    # 检查配置文件是否存在
    if not os.path.exists(data_yaml):
        raise FileNotFoundError(f"配置文件不存在: {data_yaml}")
    
    # 加载YOLO模型（使用预训练模型）
    model = YOLO('yolov8n.pt')  # 可以根据需要修改模型大小: yolov8n/s/m/l/x
    
    # 训练参数配置
    train_args = {
        'data': data_yaml,
        'epochs': 100,
        'imgsz': 640,
        'batch': 16,
        'name': 'yolo_train',
        'project': os.path.join(current_dir, 'runs'),
        'patience': 50,
        'save': True,
        'device': 0,  # 使用GPU 0，如果没有GPU则改为 'cpu'
    }
    
    {% if custom_params %}
    # 用户自定义参数（直接合并到train_args中）
    custom_params = {
        {% for key, value in custom_params.items() %}
        '{{ key }}': {{ value }},
        {% endfor %}
    }
    train_args.update(custom_params)
    {% endif %}
    
    # 打印训练参数
    print("=" * 50)
    print("训练参数配置:")
    for key, value in train_args.items():
        print(f"  {key}: {value}")
    print("=" * 50)
    
    # 开始训练
    try:
        results = model.train(**train_args)
        print("\n训练完成!")
        print(f"最佳模型保存在: {model.trainer.best}")
        return results
    except Exception as e:
        print(f"训练过程中发生错误: {e}")
        import traceback
        traceback.print_exc()
        return None


def val(run_index=None):
    """执行YOLO模型验证
    
    Args:
        run_index (int, optional): 指定训练运行索引(1,2,3...), 默认为None使用最新训练
    """
    # 获取当前脚本所在目录
    current_dir = os.path.dirname(os.path.abspath(__file__))
    
    # 配置文件路径
    data_yaml = os.path.join(current_dir, "train.yml")
    
    # 检查配置文件是否存在
    if not os.path.exists(data_yaml):
        print(f"配置文件不存在: {data_yaml}")
        return None
    
    # 查找最佳模型文件
    if run_index is not None:
        # 使用指定索引的训练目录
        if run_index == 1:
            best_model_path = os.path.join(current_dir, 'runs/detect/train/weights/best.pt')
        else:
            best_model_path = os.path.join(current_dir, f'runs/detect/train{run_index}/weights/best.pt')
    else:
        # 默认使用最新的训练目录
        best_model_path = os.path.join(current_dir, 'runs/detect/yolo_train/weights/best.pt')
        if not os.path.exists(best_model_path):
            # 尝试默认路径
            best_model_path = 'runs/detect/train/weights/best.pt'
    
    # 检查模型文件是否存在
    if not os.path.exists(best_model_path):
        print(f"未找到最佳模型: {best_model_path}")
        # 列出可用的训练目录
        runs_dir = os.path.join(current_dir, 'runs/detect')
        if os.path.exists(runs_dir):
            available_runs = [d for d in os.listdir(runs_dir) if os.path.isdir(os.path.join(runs_dir, d)) and d.startswith('train')]
            if available_runs:
                print("可用的训练目录:")
                for run in sorted(available_runs):
                    print(f"  - {run}")
        print("请先训练模型或指定正确的训练索引")
        return None
    
    print(f"使用最佳模型: {best_model_path}")
    model = YOLO(best_model_path)
    
    # 验证参数
    val_args = {
        'data': data_yaml,
    }
    
    print(f"开始验证模型，参数: {val_args}")
    
    # 开始验证
    try:
        results = model.val(**val_args)
        print("验证完成!")
        
        # 计算百分比指标
        map_percent = results.box.map * 100
        map50_percent = results.box.map50 * 100
        map75_percent = results.box.map75 * 100
        precision_percent = results.box.p.mean() * 100
        recall_percent = results.box.r.mean() * 100
        f1_percent = results.box.f1.mean() * 100
        
        # 打印关键指标（以百分比显示）
        print("\n" + "=" * 50)
        print("验证结果")
        print("=" * 50)
        print(f"mAP: {map_percent:.2f}%")
        print(f"mAP50: {map50_percent:.2f}%")
        print(f"mAP75: {map75_percent:.2f}%")
        print(f"Precision: {precision_percent:.2f}%")
        print(f"Recall: {recall_percent:.2f}%")
        print(f"F1-Score: {f1_percent:.2f}%")
        print("=" * 50)
        
        # 模型质量评估和改进建议（基于mAP指标评估）
        print("\n" + "=" * 50)
        print("模型质量评估")
        print("=" * 50)
        if map_percent >= 80:
            print("🟢 模型质量优秀 (mAP >= 80%)")
        elif map_percent >= 60:
            print("🟡 模型质量良好 (60% <= mAP < 80%)")
        elif map_percent >= 40:
            print("🟠 模型质量一般 (40% <= mAP < 60%)")
        else:
            print("🔴 模型质量较差 (mAP < 40%)")
            
        # 根据mAP50和mAP75的差异提供额外评估
        if map50_percent - map75_percent > 20:
            print("\n⚠️  注意: mAP50与mAP75差距较大，说明模型在定位精度上可能存在问题")
            
        if map_percent < 60:
            print("\n💡 改进建议:")
            print("1. 增加训练轮数 (epochs)")
            print("2. 调整学习率")
            print("3. 增加训练数据量和多样性")
            print("4. 尝试使用更大的模型")
            print("5. 检查标注质量")
            print("6. 调整数据增强策略")
            
        if precision_percent > 90 and recall_percent < 70:
            print("\n⚠️  注意: 精度过高但召回率较低，可能存在过拟合或漏检问题")
        elif recall_percent > 90 and precision_percent < 70:
            print("\n⚠️  注意: 召回率过高但精度较低，可能存在过多误检")
        
        print("=" * 50)
        return results
            
    except Exception as e:
        print(f"验证过程中发生错误: {e}")
        import traceback
        traceback.print_exc()
        return None


def benchmark():
    """执行YOLO模型基准测试"""
    # 获取当前脚本所在目录
    current_dir = os.path.dirname(os.path.abspath(__file__))
    
    # 查找最佳模型文件
    best_model_path = os.path.join(current_dir, 'runs/detect/yolo_train/weights/best.pt')
    if not os.path.exists(best_model_path):
        # 尝试默认路径
        best_model_path = 'runs/detect/train/weights/best.pt'
        if not os.path.exists(best_model_path):
            print("未找到最佳模型，请先训练模型")
            return None
    
    print(f"使用最佳模型: {best_model_path}")
    model = YOLO(best_model_path)
    
    # 基准测试参数
    bench_args = {
        'imgsz': 640,  # 默认图像尺寸
        'device': 0,   # 默认设备为GPU
    }
    
    print(f"开始基准测试，参数: {bench_args}")
    
    # 开始基准测试
    try:
        results = model.benchmark(**bench_args)
        print("基准测试完成!")
        
        # 打印关键指标
        print("\n" + "=" * 50)
        print("基准测试结果")
        print("=" * 50)
        if hasattr(results, 'speed') and results.speed:
            print(f"推理速度: {results.speed:.2f} ms/img")
        if hasattr(results, 'fps') and results.fps:
            print(f"帧率: {results.fps:.2f} FPS")
        print("=" * 50)
            
        # 性能评估和改进建议
        print("\n" + "=" * 50)
        print("性能评估")
        print("=" * 50)
        if hasattr(results, 'speed'):
            if results.speed <= 20:
                print("🟢 推理速度优秀 (<= 20ms/img)")
            elif results.speed <= 50:
                print("🟡 推理速度良好 (20-50ms/img)")
            elif results.speed <= 100:
                print("🟠 推理速度一般 (50-100ms/img)")
            else:
                print("🔴 推理速度较慢 (> 100ms/img)")
                
            if results.speed > 50:
                print("\n💡 性能优化建议:")
                print("1. 使用模型量化技术")
                print("2. 尝试更小的模型版本")
                print("3. 使用模型剪枝")
                print("4. 考虑使用TensorRT等推理优化工具")
                print("5. 降低输入图像尺寸")
        print("=" * 50)
        return results
                
    except Exception as e:
        print(f"基准测试过程中发生错误: {e}")
        import traceback
        traceback.print_exc()
        return None


def main():
    """主函数"""
    parser = argparse.ArgumentParser(description='YOLO模型训练、验证和基准测试脚本')
    parser.add_argument('action', choices=['train', 'val', 'benchmark'], 
                        help='执行的操作: train(训练), val(验证), benchmark(基准测试)')
    parser.add_argument('--run-index', type=int, choices=[1, 2, 3], 
                        help='指定验证的训练索引 (1, 2, 3)')
    
    args = parser.parse_args()
    
    if args.action == 'train':
        train()
    elif args.action == 'val':
        val(run_index=args.run_index)
    elif args.action == 'benchmark':
        benchmark()


if __name__ == '__main__':
    main()
